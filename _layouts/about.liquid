---
layout: default
---
{% assign socials = site.data.socials %}
<div class="rd-home-wrap">
  <aside class="rd-rail">
    {% if page.profile.image %}
      <img src="{{ page.profile.image | prepend: 'assets/img/' | relative_url | bust_file_cache }}" alt="{{ site.first_name }} {{ site.last_name }}">
    {% endif %}
    <div>
      <h1 class="rd-name">{{ site.first_name }} {{ site.last_name }}</h1>
      {% if page.role %}<p class="rd-role">{{ page.role }}</p>{% endif %}
    </div>
    <nav aria-label="Site">
      {% assign sorted_pages = site.pages | sort: 'nav_order' %}
      {% for p in sorted_pages %}
        {% if p.nav and p.autogen == null and p.permalink != '/' %}
          {% if p.permalink contains '/blog/' %}
            {% assign url = '/blog/' %}
          {% else %}
            {% assign url = p.url %}
          {% endif %}
          <a href="{{ url | relative_url }}">{{ p.title }}</a>
        {% endif %}
      {% endfor %}
    </nav>
    <div class="rd-contact">
      {% if socials.email %}<a href="mailto:{{ socials.email | encode_email }}">email</a>{% endif %}
      {% if socials.github_username %}<a href="https://github.com/{{ socials.github_username }}">github</a>{% endif %}
      {% if socials.linkedin_username %}<a href="https://www.linkedin.com/in/{{ socials.linkedin_username }}">linkedin</a>{% endif %}
      {% if socials.scholar_userid %}<a href="https://scholar.google.com/citations?user={{ socials.scholar_userid }}">scholar</a>{% endif %}
      {% if site.enable_darkmode %}
        <button type="button" id="rd-theme" title="Change theme" aria-label="Change theme" onclick="document.getElementById('light-toggle').click()">
          <i class="ti ti-sun-moon"></i>
        </button>
      {% endif %}
    </div>
  </aside>

  <main class="rd-main">
    <section class="rd-prose" aria-label="About">
      {{ content }}
    </section>

    {% if page.announcements and page.announcements.enabled %}
      <section aria-labelledby="news-h">
        <h2 class="rd-h" id="news-h">News <a href="{{ '/news/' | relative_url }}">all news</a></h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <section id="publications" aria-labelledby="pubs-h">
      <h2 class="rd-h" id="pubs-h">Selected publications <a href="{{ '/publications/' | relative_url }}">all publications →</a></h2>
      {% include selected_publications.liquid selected=true %}
    </section>

    <footer class="rd-site-foot">&copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}</footer>
  </main>
</div>
