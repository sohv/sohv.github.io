<div class="rd-proj">
  <h3>{{ entry.title }}</h3>
  <p>{{ entry.description }}</p>
  <div class="rd-meta">
    {% if entry.github %}<a href="{{ entry.github }}">code</a>{% endif %}
    {% if entry.website %}<a href="{{ entry.website }}">website</a>{% endif %}
    {% if entry.youtube %}<a href="{{ entry.youtube }}">video</a>{% endif %}
    {% if entry.pdf %}
      {% if entry.pdf contains '://' %}
        <a href="{{ entry.pdf }}">pdf</a>
      {% else %}
        <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}">pdf</a>
      {% endif %}
    {% endif %}
  </div>
</div>
